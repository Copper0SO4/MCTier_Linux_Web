@@ -1,0 +2 @@
+import { isLocalWeb } from '../platform/localWeb';
@@ -106,0 +108,15 @@
+  if (isLocalWeb()) {
+    if (remote) throw new Error('Linux 浏览器被控端的输入授权尚未实现');
+    if (signal?.aborted) throw new DOMException('Cancelled', 'AbortError');
+    if (!navigator.mediaDevices?.getDisplayMedia) throw new Error('此浏览器不支持屏幕捕获');
+    const q = normalizeScreenQuality(quality);
+    // Called directly from a user's click: keep browser activation through the picker.
+    const stream = await navigator.mediaDevices.getDisplayMedia({
+      video: { height: { ideal: q.resolution }, frameRate: { ideal: q.frameRate } }, audio: false,
+    });
+    if (signal?.aborted) { stream.getTracks().forEach(track => track.stop()); throw new DOMException('Cancelled', 'AbortError'); }
+    const stop = () => stream.getTracks().forEach(track => track.stop());
+    signal?.addEventListener('abort', stop, { once: true });
+    stream.getVideoTracks()[0]?.addEventListener('ended', () => signal?.removeEventListener('abort', stop), { once: true });
+    return stream;
+  }
