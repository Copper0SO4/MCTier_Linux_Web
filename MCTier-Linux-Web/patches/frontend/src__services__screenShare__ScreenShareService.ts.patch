+
+  /** Explicit refresh uses the existing cross-platform broadcast protocol. */
+  requestShareList(): void {
+    this.sendWebSocketMessage({ type: 'screen-share-list-request', from: this.currentPlayerId });
+  }
+
+  getViewingDiagnostics(shareId: string) {
+    const connections = [...this.peerConnections.entries()]
+      .filter(([key]) => key.startsWith(`${shareId}-in-`) || key.startsWith(`${shareId}-viewer-`))
+      .map(([, pc]) => ({ connection: pc.connectionState, ice: pc.iceConnectionState, signaling: pc.signalingState }));
+    return { connections, track: this.remoteStreams.get(shareId)?.getVideoTracks()[0]?.readyState ?? 'pending' };
