+  /** A local diagnostic view; never exposes SDP, addresses or ICE credentials. */
+  async getVoiceDiagnostics(): Promise<Array<{
+    playerId: string; connection: RTCPeerConnectionState; ice: RTCIceConnectionState;
+    signaling: RTCSignalingState; selectedPair: boolean; localType?: string;
+    remoteType?: string; protocol?: string; roundTripTime?: number;
+    sentPackets: number; receivedPackets: number; sentBytes: number; receivedBytes: number;
+    playbackBlocked: boolean; playbackError?: string;
+  }>> {
+    const entries = [...this.peerConnections.entries()];
+    return Promise.all(entries.map(async ([playerId, peer]) => {
+      const diagnostic = {
+        playerId, connection: peer.connection.connectionState, ice: peer.connection.iceConnectionState,
+        signaling: peer.connection.signalingState, selectedPair: false,
+        localType: undefined as string | undefined, remoteType: undefined as string | undefined,
+        protocol: undefined as string | undefined, roundTripTime: undefined as number | undefined,
+        sentPackets: 0, receivedPackets: 0, sentBytes: 0, receivedBytes: 0,
+        playbackBlocked: !!peer.lastPlaybackError, playbackError: peer.lastPlaybackError,
+      };
+      try {
+        const stats = await peer.connection.getStats();
+        let pairId: string | undefined;
+        stats.forEach(report => {
+          if (report.type === 'transport') pairId = report.selectedCandidatePairId;
+          if ((report.kind ?? report.mediaType) === 'audio') {
+            if (report.type === 'outbound-rtp') { diagnostic.sentPackets += report.packetsSent || 0; diagnostic.sentBytes += report.bytesSent || 0; }
+            if (report.type === 'inbound-rtp') { diagnostic.receivedPackets += report.packetsReceived || 0; diagnostic.receivedBytes += report.bytesReceived || 0; }
+          }
+        });
+        let pair = pairId ? stats.get(pairId) : undefined;
+        if (!pair) stats.forEach(report => { if (report.type === 'candidate-pair' && report.nominated && report.state === 'succeeded') pair = report; });
+        if (pair) {
+          diagnostic.selectedPair = pair.state === 'succeeded';
+          const local = stats.get(pair.localCandidateId);
+          const remote = stats.get(pair.remoteCandidateId);
+          diagnostic.localType = local?.candidateType;
+          diagnostic.remoteType = remote?.candidateType;
+          diagnostic.protocol = local?.protocol;
+          diagnostic.roundTripTime = pair.currentRoundTripTime;
+        }
+      } catch { /* The peer can close while a diagnostic snapshot is in flight. */ }
+      return diagnostic;
+    }));
+  }
